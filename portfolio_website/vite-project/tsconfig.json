{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "strict": true,

    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",

    "esModuleInterop": true,

    "allowJs": true,
    "checkJs": false,
    
    "noEmit": true,

    "jsx": "react-jsx",
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
